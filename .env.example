# Optional. If set, the server authenticates every request with this key and the
# browser sign-in screen is skipped. Leave unset to sign in with a key in the UI.
ANTHROPIC_API_KEY=

# Port for the Express API in development (the Vite dev server proxies /api here).
# Deliberately not PORT — that name collides with the Vite dev server under many
# harnesses. In production the server honours the platform's PORT.
API_PORT=3001
